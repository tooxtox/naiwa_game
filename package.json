{
  "name": "naiwa-happy-reboot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build --config vite/config.prod.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "deploy:edgeone": "npm run build && npx --yes edgeone@1.6.47 makers deploy ./dist --name naiwa-game --env production --skip-ai-gateway-sync",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "~5.7.2",
    "vite": "^6.3.1"
  },
  "dependencies": {
    "phaser": "4.0.0",
    "terser": "^5.39.0"
  }
}
